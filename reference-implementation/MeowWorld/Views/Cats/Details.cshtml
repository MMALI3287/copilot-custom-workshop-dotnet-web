@model Cat
@{
    ViewData["Title"] = L["Page_CatDetails_Title"].Value;
    ViewData["Active"] = "Cats";
}

<h1 class="h2 mb-3" data-i18n="Page_CatDetails_Title">@L["Page_CatDetails_Title"]</h1>

<dl class="row">
    <dt class="col-sm-3" data-i18n="Col_Id">@L["Col_Id"]</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3" data-i18n="Col_Name">@L["Col_Name"]</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3" data-i18n="Col_Age">@L["Col_Age"]</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3" data-i18n="Col_Breed">@L["Col_Breed"]</dt>
    <dd class="col-sm-9">@Model.Breed</dd>

    <dt class="col-sm-3" data-i18n="Col_Description">@L["Col_Description"]</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3" data-i18n="Col_IsFavorite">@L["Col_IsFavorite"]</dt>
    <dd class="col-sm-9" data-i18n="@(Model.IsFavorite ? "Msg_Yes" : "Msg_No")">
        @(Model.IsFavorite ? L["Msg_Yes"] : L["Msg_No"])
    </dd>

    <dt class="col-sm-3" data-i18n="Col_CreatedAt">@L["Col_CreatedAt"]</dt>
    @* 日付は SupportedCultures により書式が切り替わる *@
    <dd class="col-sm-9">@Model.CreatedAt.ToString("d")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning" data-i18n="Action_Edit">@L["Action_Edit"]</a>
<a asp-action="Index" class="btn btn-secondary" data-i18n="Action_BackToList">@L["Action_BackToList"]</a>
