@model Cat
@{
    ViewData["Title"] = L["Page_CatDelete_Title"].Value;
    ViewData["Active"] = "Cats";
}

<h1 class="h2 mb-3" data-i18n="Page_CatDelete_Title">@L["Page_CatDelete_Title"]</h1>

<div class="alert alert-warning">
    <p class="mb-1 fw-semibold" data-i18n="Msg_DeleteConfirm">@L["Msg_DeleteConfirm"]</p>
    <p class="mb-0" data-i18n="Msg_DeleteIrreversible">@L["Msg_DeleteIrreversible"]</p>
</div>

<dl class="row">
    <dt class="col-sm-3" data-i18n="Col_Name">@L["Col_Name"]</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3" data-i18n="Col_Age">@L["Col_Age"]</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3" data-i18n="Col_Breed">@L["Col_Breed"]</dt>
    <dd class="col-sm-9">@Model.Breed</dd>

    <dt class="col-sm-3" data-i18n="Col_Description">@L["Col_Description"]</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger" data-i18n="Action_ConfirmDelete">@L["Action_ConfirmDelete"]</button>
    <a asp-action="Index" class="btn btn-secondary" data-i18n="Action_Cancel">@L["Action_Cancel"]</a>
</form>
