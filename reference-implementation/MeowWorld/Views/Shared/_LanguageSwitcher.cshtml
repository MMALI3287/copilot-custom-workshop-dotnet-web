@using System.Globalization
@{
    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
@* JS が有効なら i18n.js が submit を横取りして即時切り替えする。
   無効な場合は通常の POST としてサーバー側で切り替わる。 *@
<form asp-controller="Culture" asp-action="Set" method="post"
      class="m-0 js-lang-switcher" data-return-url="@returnUrl">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <div class="btn-group btn-group-sm" role="group" aria-label="@L["Lang_SwitcherLabel"]">
        <button type="submit" name="culture" value="ja" lang="ja"
                class="btn @(current == "ja" ? "btn-light" : "btn-outline-light")"
                aria-pressed="@(current == "ja" ? "true" : "false")">日本語</button>
        <button type="submit" name="culture" value="en" lang="en"
                class="btn @(current == "en" ? "btn-light" : "btn-outline-light")"
                aria-pressed="@(current == "en" ? "true" : "false")">English</button>
    </div>
</form>
